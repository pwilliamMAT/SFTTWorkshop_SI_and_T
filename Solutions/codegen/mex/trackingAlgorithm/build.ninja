# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = C:/Program Files/MATLAB/R2025b
startdir = C:/Users/pwilliam/OneDrive - MathWorks/Documents/SFTT/SFTTWorkshopPart2/SFTTWorkshop_SI_and_T/Solutions

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
cxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++
linker = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\gcc
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2025b\3P.instrset\mingw_w64.instrset\bin\g++

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "C:\Users\pwilliam\OneDrive - MathWorks\Documents\SFTT\SFTTWorkshopPart2\SFTTWorkshop_SI_and_T\Solutions\codegen\mex\trackingAlgorithm" -I "C:\Users\pwilliam\OneDrive - MathWorks\Documents\SFTT\SFTTWorkshopPart2\SFTTWorkshop_SI_and_T\Solutions" -I "C:\Users\pwilliam\OneDrive - MathWorks\Documents\SFTT\SFTTWorkshopPart2\SFTTWorkshop_SI_and_T\Solutions\codegen\mex\trackingAlgorithm\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=trackingAlgorithm_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "C:\Users\pwilliam\OneDrive - MathWorks\Documents\SFTT\SFTTWorkshopPart2\SFTTWorkshop_SI_and_T\Solutions\codegen\mex\trackingAlgorithm" -I "C:\Users\pwilliam\OneDrive - MathWorks\Documents\SFTT\SFTTWorkshopPart2\SFTTWorkshop_SI_and_T\Solutions" -I "C:\Users\pwilliam\OneDrive - MathWorks\Documents\SFTT\SFTTWorkshopPart2\SFTTWorkshop_SI_and_T\Solutions\codegen\mex\trackingAlgorithm\interface" -I "C:\Program Files\MATLAB\R2025b\extern\include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=trackingAlgorithm_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -fopenmp 

ldflags = trackingAlgorithm.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "trackingAlgorithm_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

ldxxflags = trackingAlgorithm.def  -m64 -Wl,--no-undefined -shared -static -L"C:\Program Files\MATLAB\R2025b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "trackingAlgorithm_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwlapack -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil -fopenmp

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/trackingAlgorithm_data.o : cc $root/trackingAlgorithm_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/trackingAlgorithm_initialize.o : cc $root/trackingAlgorithm_initialize.c
