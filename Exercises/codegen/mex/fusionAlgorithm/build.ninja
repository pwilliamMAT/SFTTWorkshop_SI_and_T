# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /MATLAB
startdir = /MATLAB Drive/Repositories/SFTTWorkshop_SI_and_T-6/Exercises

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$root" -I "$matlabdir Drive/Repositories/SFTTWorkshop_SI_and_T-6/Exercises" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=fusionAlgorithm_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$root" -I "$matlabdir Drive/Repositories/SFTTWorkshop_SI_and_T-6/Exercises" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DHAVE_LAPACK_CONFIG_H -DLAPACK_COMPLEX_STRUCTURE -DMW_HAVE_LAPACK_DECLS -DMODEL=fusionAlgorithm_mex -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized -c -fopenmp -DOMPLIBNAME="$matlabdir/sys/os/glnxa64/libiomp5.so" 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o fusionAlgorithm_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwlapack -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,fusionAlgorithm.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o fusionAlgorithm_mex.mexa64 -L"$matlabdir/bin/glnxa64" -lmwlapack -lmwblas -lemlrt -lcovrt -lut -lmwmathutil -fPIC -L"$matlabdir/sys/os/glnxa64" -liomp5 -Wl,--version-script,fusionAlgorithm.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/fusionAlgorithm_data.o : cc $root/fusionAlgorithm_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/fusionAlgorithm_initialize.o : cc $root/fusionAlgorithm_initialize.c
build $builddir/fusionAlgorithm_terminate.o : cc $root/fusionAlgorithm_terminate.c
build $builddir/fusionAlgorithm.o : cc $root/fusionAlgorithm.c
build $builddir/fuserSourceConfiguration.o : cc $root/fuserSourceConfiguration.c
build $builddir/unique.o : cc $root/unique.c
build $builddir/SystemCore.o : cc $root/SystemCore.c
build $builddir/FuserManager.o : cc $root/FuserManager.c
build $builddir/validateattributes.o : cc $root/validateattributes.c
build $builddir/isSymmetricPositiveSemiDefinite.o : cc $root/isSymmetricPositiveSemiDefinite.c
build $builddir/all.o : cc $root/all.c
build $builddir/eig.o : cc $root/eig.c
build $builddir/xnrm2.o : cc $root/xnrm2.c
build $builddir/warning.o : cc $root/warning.c
build $builddir/eigSkewHermitianStandard.o : cc $root/eigSkewHermitianStandard.c
build $builddir/sumMatrixIncludeNaN.o : cc $root/sumMatrixIncludeNaN.c
build $builddir/objectTrack.o : cc $root/objectTrack.c
build $builddir/trackFuser.o : cc $root/trackFuser.c
build $builddir/repmat.o : cc $root/repmat.c
build $builddir/assertValidSizeArg.o : cc $root/assertValidSizeArg.c
build $builddir/find.o : cc $root/find.c
build $builddir/indexShapeCheck.o : cc $root/indexShapeCheck.c
build $builddir/AssignerGNN.o : cc $root/AssignerGNN.c
build $builddir/matchpairs.o : cc $root/matchpairs.c
build $builddir/eml_setop.o : cc $root/eml_setop.c
build $builddir/issorted.o : cc $root/issorted.c
build $builddir/any.o : cc $root/any.c
build $builddir/combineVectorElements.o : cc $root/combineVectorElements.c
build $builddir/fusecovint.o : cc $root/fusecovint.c
build $builddir/validateCovFusion.o : cc $root/validateCovFusion.c
build $builddir/mldivide.o : cc $root/mldivide.c
build $builddir/_coder_fusionAlgorithm_api.o : cc $root/interface/_coder_fusionAlgorithm_api.c
build $builddir/_coder_fusionAlgorithm_mex.o : cc $root/interface/_coder_fusionAlgorithm_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/geodetic2ecefFormula.o : cc $root/geodetic2ecefFormula.c
build $builddir/xzgehrd.o : cc $root/xzgehrd.c
build $builddir/xzlarf.o : cc $root/xzlarf.c
build $builddir/xzlarfg.o : cc $root/xzlarfg.c
build $builddir/xdlanv2.o : cc $root/xdlanv2.c
build $builddir/xrot.o : cc $root/xrot.c
build $builddir/cosd.o : cc $root/cosd.c
build $builddir/sind.o : cc $root/sind.c
build $builddir/constvel.o : cc $root/constvel.c
build $builddir/gaussEKFilter.o : cc $root/gaussEKFilter.c
build $builddir/mrdivide_helper.o : cc $root/mrdivide_helper.c
build $builddir/xzgetrf.o : cc $root/xzgetrf.c
build $builddir/minPriorityQueue.o : cc $root/minPriorityQueue.c
build $builddir/sort.o : cc $root/sort.c
build $builddir/sortIdx.o : cc $root/sortIdx.c
build $builddir/Fuserxcov.o : cc $root/Fuserxcov.c
build $builddir/ensurePosDefMatrix.o : cc $root/ensurePosDefMatrix.c
build $builddir/xhseqr.o : cc $root/xhseqr.c
build $builddir/fusionAlgorithm_emxutil.o : cc $root/fusionAlgorithm_emxutil.c
build $builddir/_coder_fusionAlgorithm_info.o : cc $root/interface/_coder_fusionAlgorithm_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/fusionAlgorithm_mex.mexa64 : link $builddir/fusionAlgorithm_data.o $builddir/rt_nonfinite.o $builddir/fusionAlgorithm_initialize.o $builddir/fusionAlgorithm_terminate.o $builddir/fusionAlgorithm.o $builddir/fuserSourceConfiguration.o $builddir/unique.o $builddir/SystemCore.o $builddir/FuserManager.o $builddir/validateattributes.o $builddir/isSymmetricPositiveSemiDefinite.o $builddir/all.o $builddir/eig.o $builddir/xnrm2.o $builddir/warning.o $builddir/eigSkewHermitianStandard.o $builddir/sumMatrixIncludeNaN.o $builddir/objectTrack.o $builddir/trackFuser.o $builddir/repmat.o $builddir/assertValidSizeArg.o $builddir/find.o $builddir/indexShapeCheck.o $builddir/AssignerGNN.o $builddir/matchpairs.o $builddir/eml_setop.o $builddir/issorted.o $builddir/any.o $builddir/combineVectorElements.o $builddir/fusecovint.o $builddir/validateCovFusion.o $builddir/mldivide.o $builddir/_coder_fusionAlgorithm_api.o $builddir/_coder_fusionAlgorithm_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/geodetic2ecefFormula.o $builddir/xzgehrd.o $builddir/xzlarf.o $builddir/xzlarfg.o $builddir/xdlanv2.o $builddir/xrot.o $builddir/cosd.o $builddir/sind.o $builddir/constvel.o $builddir/gaussEKFilter.o $builddir/mrdivide_helper.o $builddir/xzgetrf.o $builddir/minPriorityQueue.o $builddir/sort.o $builddir/sortIdx.o $builddir/Fuserxcov.o $builddir/ensurePosDefMatrix.o $builddir/xhseqr.o $builddir/fusionAlgorithm_emxutil.o $builddir/_coder_fusionAlgorithm_info.o $builddir/c_mexapi_version.o 
